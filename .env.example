# Operator-injected configuration; the CLI does not load this file automatically.
# Use a separate disposable Google test account. Never paste credentials into chat.
PROOFBEAK_GOOGLE_TEST_ACCOUNT=dedicated-test-account@example.test
PROOFBEAK_GOOGLE_ACCESS_TOKEN=replace-with-a-short-lived-access-token

# Optional local providers
PROOFBEAK_RADICALE_URL=http://127.0.0.1:5232
PROOFBEAK_RADICALE_USERNAME=proofbeak
PROOFBEAK_RADICALE_PASSWORD=proofbeak-local-only
PROOFBEAK_FILESYSTEM_ROOT=.proofbeak/storage

# Optional disposable self-hosted WebDAV fixtures (compose.storage.yaml).
PROOFBEAK_WEBDAV_WSGIDAV_URL=http://127.0.0.1:8801
PROOFBEAK_WEBDAV_WSGIDAV_USERNAME=proofbeak
PROOFBEAK_WEBDAV_WSGIDAV_PASSWORD=proofbeak-local-only
PROOFBEAK_WEBDAV_APACHE_URL=http://127.0.0.1:8802
PROOFBEAK_WEBDAV_APACHE_USERNAME=proofbeak
PROOFBEAK_WEBDAV_APACHE_PASSWORD=proofbeak-local-only

# Optional public/read-only HTTP JSON connector; configure your own origin and route map.
# Candidate: scenario:http:catalog-a. This illustrative hostname is not a working service.
PROOFBEAK_HTTP_CATALOG_A_URL=https://catalog.example.test
PROOFBEAK_HTTP_CATALOG_A_ROUTES='{"item":{"path":"/items/{key}","project":{"ready":["item","enabled"]}}}'
