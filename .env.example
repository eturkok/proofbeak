# Operator-injected configuration; the CLI does not load this file automatically.
# Use a separate disposable Google test account. Never paste credentials into chat.
PROOFBEAK_GOOGLE_TEST_ACCOUNT=dedicated-test-account@example.test
PROOFBEAK_GOOGLE_ACCESS_TOKEN=replace-with-a-short-lived-access-token

# Optional local providers
PROOFBEAK_RADICALE_URL=http://127.0.0.1:5232
PROOFBEAK_RADICALE_USERNAME=proofbeak
PROOFBEAK_RADICALE_PASSWORD=proofbeak-local-only
PROOFBEAK_FILESYSTEM_ROOT=.proofbeak/storage
