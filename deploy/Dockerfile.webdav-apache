# Disposable integration fixture, not a Proofbeak runtime dependency.
FROM httpd:2.4.71@sha256:07e4ec0094d8bca9765fae74ce33d2be5341884048f265ff9dc1d1177a4256c9
RUN groupadd --gid 10001 proofbeak \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin proofbeak \
    && htpasswd -bc /usr/local/apache2/conf/test-users proofbeak proofbeak-local-only \
    && chown 10001:10001 /usr/local/apache2/htdocs
COPY deploy/webdav-apache.conf /usr/local/apache2/conf/httpd.conf
USER 10001:10001
EXPOSE 8080
CMD ["httpd", "-DFOREGROUND"]
